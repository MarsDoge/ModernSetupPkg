##

[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = ModernSetupPkg
  PACKAGE_GUID                   = 8B5E39C3-7D63-49F7-A32E-BC476C117B72
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[Guids]
  gModernSetupPkgTokenSpaceGuid = { 0x6D1B8B66, 0x2C67, 0x4E6B, { 0xA8, 0xB6, 0x43, 0x50, 0x1F, 0xCB, 0x54, 0x6E } }

[LibraryClasses]
  # DisplayEngine main path.
  ModernUiEngineLib|Include/ModernUi/ModernUiEngine.h
  ModernUiRendererLib|Include/ModernUi/ModernUiRenderer.h
  ModernUiThemeLib|Include/ModernUi/ModernUiTheme.h

  # Optional ModernSetupApp front-page path. These are intentionally not used
  # by the default ArmVirt overlay or the main package DSC.
  ModernUiPlatformDataLib|Include/ModernUi/ModernUiPlatformData.h
  ModernUiBootDataLib|Include/ModernUi/ModernUiBootData.h
  ModernUiDeviceDataLib|Include/ModernUi/ModernUiDeviceData.h
  ModernUiSecurityDataLib|Include/ModernUi/ModernUiSecurityData.h
  ModernUiFirmwareDataLib|Include/ModernUi/ModernUiFirmwareData.h
  ModernUiDiagnosticsDataLib|Include/ModernUi/ModernUiDiagnosticsData.h
  ModernUiManagementDataLib|Include/ModernUi/ModernUiManagementData.h
  ModernUiPowerDataLib|Include/ModernUi/ModernUiPowerData.h
  ModernUiPerformanceDataLib|Include/ModernUi/ModernUiPerformanceData.h
  ModernUiPcieDataLib|Include/ModernUi/ModernUiPcieData.h
  ModernUiInputLib|Include/ModernUi/ModernUiInput.h
  ModernUiStringLib|Include/ModernUi/ModernUiString.h
  ModernUiHiiBridgeLib|Include/ModernUi/ModernUiHiiBridge.h
  ModernUiPageAdapterLib|Include/ModernUi/ModernUiPageAdapter.h

[PcdsFixedAtBuild]
  gModernSetupPkgTokenSpaceGuid.PcdModernSetupDefaultLanguage|"zh-Hans"|VOID*|0x00000001
  ## Selects the built-in DisplayEngine theme.
  #  0 = black/orange, 1 = black/deep-red/yellow.
  gModernSetupPkgTokenSpaceGuid.PcdModernSetupTheme|0x00|UINT8|0x00000002
